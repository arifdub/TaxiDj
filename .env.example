# ---------------------------------------------------------------------------
# Taxi DJ environment variables
# Copy to .env.local for local development; add the same keys in Vercel
# (Project → Settings → Environment Variables) for deployments.
# ---------------------------------------------------------------------------

# REQUIRED — browser + server. Supabase project URL.
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED — browser + server. Supabase "anon" / publishable key.
# Safe to expose: all access is enforced by Row Level Security.
# Never put the service_role key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL — server only (never prefixed with NEXT_PUBLIC_).
# YouTube Data API v3 key used by /api/youtube/search.
# Without it, search is disabled with a friendly message and passengers can
# still paste YouTube / YouTube Music links.
YOUTUBE_API_KEY=

# OPTIONAL — browser. Public site URL encoded in the QR codes,
# e.g. https://taxidj.com. Defaults to the current browser origin.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL — server only. Enables Spotify *search*. Not needed for pasting
# Spotify song links, which works with just YOUTUBE_API_KEY.
# developer.spotify.com/dashboard → Create app (Web API) → Settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Google Search Console "HTML tag" verification code (the content="…" value).
GOOGLE_SITE_VERIFICATION=
